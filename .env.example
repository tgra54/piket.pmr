# Salin file ini menjadi ".env" lalu isi. JANGAN dibagikan / di-upload.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API > service_role (RAHASIA)
SUPABASE_SERVICE_ROLE_KEY=
# Kunci anon (sama dengan yang di web/script.js), dipakai oleh: npm run cek
SUPABASE_ANON_KEY=
